# Telegram
TELEGRAM_TOKEN=your-telegram-bot-token

# LLM
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=

# Redis (единственный persistence!)
REDIS_URL=redis://localhost:6379/0

# CRM adapter: bitrix | amo | mock
CRM_ADAPTER=mock

# Bitrix24 (если CRM_ADAPTER=bitrix)
BITRIX_WEBHOOK=https://your-domain.bitrix24.ru/rest/1/your-token/

# AmoCRM (если CRM_ADAPTER=amo)
AMO_SUBDOMAIN=
AMO_ACCESS_TOKEN=
AMO_REFRESH_TOKEN=
AMO_CLIENT_ID=
AMO_CLIENT_SECRET=
AMO_REDIRECT_URI=

# PII (152-ФЗ)
PII_ENABLED=true
